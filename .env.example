# URL publique du site (SEO, sitemap, Open Graph).
# Sur Vercel, si elle n'est pas définie, le domaine de production Vercel est utilisé.
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr

# Envoi des formulaires par e-mail (facultatif).
# Sans ces variables, la messagerie du visiteur s'ouvre avec la demande pré-remplie.
RESEND_API_KEY=
FORM_FROM_EMAIL="Site Pharmacie des Buttes Blanches <site@votre-domaine.fr>"
# Destinataire (par défaut : l'e-mail de src/config/pharmacy.ts)
FORM_TO_EMAIL=
